{
  "name": "slack-axi-cli",
  "version": "0.1.0",
  "description": "Agent-ergonomic Slack CLI with bounded output and safe mutations",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aimlesx/slack-axi.git"
  },
  "homepage": "https://github.com/aimlesx/slack-axi#readme",
  "bugs": {
    "url": "https://github.com/aimlesx/slack-axi/issues"
  },
  "type": "module",
  "bin": {
    "slack-axi": "dist/index.js"
  },
  "man": "docs/slack-axi.1",
  "files": [
    "dist/**/*.js",
    "completions/_slack-axi",
    "completions/slack-axi.bash",
    "docs/slack-axi.1",
    "slack-app-manifest.json",
    "npm-shrinkwrap.json",
    "README.md",
    "PRIVACY.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "os": [
    "darwin"
  ],
  "cpu": [
    "arm64",
    "x64"
  ],
  "scripts": {
    "clean": "node --input-type=module --eval \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "generate": "npm run build && node scripts/generate-docs.mjs",
    "check": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "npm run generate"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "@napi-rs/keyring": "1.3.0",
    "@slack/web-api": "8.0.0",
    "@toon-format/toon": "4.1.1",
    "commander": "15.0.0",
    "json-canonicalize": "2.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "license": "MIT"
}
